# Biến môi trường back-end — .env giữ đúng các dòng như .env.example, chỉ khác giá trị.

# --- Máy chủ ---
# Môi trường: development | test | production (production bắt buộc tự đặt các khóa bí mật)
NODE_ENV=development
# Cổng API
PORT=3001
# Origin của FE cho CORS
FRONTEND_ORIGIN=http://localhost:5173
# Số reverse proxy trước API: false (không proxy) | 1 | danh sách IP/subnet
TRUST_PROXY=false

# --- Database ---
# Chuỗi kết nối PostgreSQL (Supabase: Session pooler, cổng 5432)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/aura_museum
# Bật TLS khi kết nối DB (Supabase: true)
DATABASE_SSL=false
# File CA để xác thực chứng chỉ DB (tùy chọn)
DATABASE_SSL_CA=

# --- Supabase Storage ---
# Project URL của Supabase
SUPABASE_URL=
# Khóa secret Supabase (chỉ dùng ở back-end)
SUPABASE_SECRET_KEY=
# Bucket private chứa media
SUPABASE_STORAGE_BUCKET=museum-assets

# --- Xác thực ---
# Khóa ký access token JWT (production >= 32 ký tự: openssl rand -hex 32)
JWT_ACCESS_SECRET=đổi-khóa-bí-mật-tối-thiểu-16-ký-tự
# Khóa mã hóa secret 2FA (TOTP) lưu trong DB (>= 32 ký tự: openssl rand -hex 32). Đổi khóa = mọi người phải bật lại 2FA
TOTP_ENCRYPTION_KEY=đổi-khóa-mã-hóa-2fa-tối-thiểu-32-ký-tự
# Hạn access token
JWT_ACCESS_TTL=15m
# Hạn refresh token (ngày)
JWT_REFRESH_TTL_DAYS=7
# Tên cookie chứa refresh token
REFRESH_COOKIE_NAME=aura_rt
# Cost factor hash mật khẩu bcrypt (10–15)
BCRYPT_ROUNDS=12
# Số lần làm mới phiên (/auth/refresh) tối đa mỗi phút cho một phiên đăng nhập
REFRESH_RATE_LIMIT_PER_SESSION=30
# Trần /auth/refresh mỗi phút cho một IP (nhiều người dùng chung IP văn phòng)
REFRESH_RATE_LIMIT_PER_IP=300
# /auth/refresh mỗi phút cho một IP khi không có hoặc sai cookie (chống dò token)
REFRESH_RATE_LIMIT_INVALID_PER_IP=20
# Số báo cáo nội dung công khai tối đa mỗi IP mỗi phút (1–100, mặc định 5)
PUBLIC_REPORT_RATE_LIMIT=5

# --- Media ---
# Origin công khai của API để dựng URL media
MEDIA_PUBLIC_BASE_URL=http://localhost:3001
# Khóa ký URL xem trước media (>= 32 ký tự: openssl rand -hex 32)
MEDIA_URL_SIGNING_SECRET=đổi-khóa-ký-url-media-tối-thiểu-32-ký-tự
# Hạn URL media đã ký (giây)
MEDIA_SIGNED_URL_TTL_SECONDS=900
# Nơi lưu file media: local | supabase
MEDIA_STORAGE_DRIVER=local
# Job dọn media mồ côi (03:30 hằng đêm): off | dry-run (chỉ log số lượng) | on (xóa thật, không lấy lại được)
MEDIA_ORPHAN_CLEANUP=dry-run
# Số ngày media đã xóa còn nằm trong Thùng rác trước khi bị xóa vĩnh viễn
MEDIA_TRASH_RETENTION_DAYS=30

# --- Seed (chỉ dùng khi chạy npm run seed) ---
# Email admin đầu tiên
SEED_ADMIN_EMAIL=admin@aura.local
# Mật khẩu admin đầu tiên
SEED_ADMIN_PASSWORD=
# Đặt true khi muốn khôi phục quyền mặc định cho các role đã tùy chỉnh (moderator, editor)
SEED_RESET_RBAC=false
