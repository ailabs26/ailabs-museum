# =====================================================================================
# Biến môi trường back-end. `.env` có ĐÚNG các dòng như `.env.example` (cùng thứ tự, cùng số dòng),
# chỉ khác giá trị → mở hai file cạnh nhau để so từng dòng. Thêm biến mới: thêm vào cả hai file cùng vị trí.
# =====================================================================================

# --- Máy chủ ---
# development | test | production. Khi production: JWT_ACCESS_SECRET và MEDIA_URL_SIGNING_SECRET phải tự đặt,
# >= 32 ký tự, khác khóa mẫu bên dưới — nếu không app từ chối khởi động. Sinh khóa: openssl rand -hex 32
NODE_ENV=development
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173
# Số reverse proxy đứng trước API (nginx, load balancer...) để lấy đúng IP client cho rate limit, phiên, audit:
# false (mặc định, không proxy) | số hop, vd 1 | danh sách IP/subnet, vd loopback,10.0.0.0/8.
# KHÔNG đặt khi API nhận request trực tiếp — client tự giả được X-Forwarded-For.
TRUST_PROXY=false

# --- Database ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/aura_museum
# Supabase: dùng chuỗi "Session pooler" (cổng 5432), KHÔNG thêm ?sslmode= vào URL, vd
# DATABASE_URL=postgresql://postgres.<ref>:<mật-khẩu>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Bật TLS (bắt buộc với Supabase) + CA tải ở Project Settings → Database → SSL Configuration.
DATABASE_SSL=false
DATABASE_SSL_CA=

# --- Supabase Storage (chỉ phía server, tuyệt đối không dùng VITE_ cho secret) ---
# Nếu dùng legacy key, có thể dùng SUPABASE_SERVICE_ROLE_KEY thay SUPABASE_SECRET_KEY.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=museum-assets

# --- Xác thực (JWT + refresh token) ---
JWT_ACCESS_SECRET=đổi-khóa-bí-mật-tối-thiểu-16-ký-tự
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
REFRESH_COOKIE_NAME=aura_rt
BCRYPT_ROUNDS=12

# --- Phân phối media ---
# Origin công khai của API — dựng URL media tuyệt đối cho FE chạy khác origin.
MEDIA_PUBLIC_BASE_URL=http://localhost:3001
# Khóa HMAC ký URL xem trước media chưa công khai (>= 32 ký tự). BẮT BUỘC đổi ở môi trường thật.
MEDIA_URL_SIGNING_SECRET=đổi-khóa-ký-url-media-tối-thiểu-32-ký-tự
MEDIA_SIGNED_URL_TTL_SECONDS=900
# Nơi lưu file media: local (đĩa, dev) | supabase (dùng SUPABASE_* ở trên, cùng bucket PRIVATE với GLB của tour).
# File chỉ ra ngoài qua API, không public bucket.
MEDIA_STORAGE_DRIVER=local

# --- Seed admin đầu tiên (chỉ dùng khi chạy `npm run seed`) ---
SEED_ADMIN_EMAIL=admin@aura.local
SEED_ADMIN_PASSWORD=
