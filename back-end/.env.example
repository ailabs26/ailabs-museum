# Máy chủ
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://postgres:postgres@localhost:5432/aura_museum
# Supabase: dùng chuỗi "Session pooler" (cổng 5432), KHÔNG thêm ?sslmode= vào URL, vd
# DATABASE_URL=postgresql://postgres.<ref>:<mật-khẩu>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Bật TLS (bắt buộc với Supabase) + CA tải ở Project Settings → Database → SSL Configuration.
DATABASE_SSL=false
DATABASE_SSL_CA=

# Storage private: chỉ phía server, tuyệt đối không dùng VITE_ cho secret.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=museum-assets
# Nếu dùng legacy key, có thể dùng SUPABASE_SERVICE_ROLE_KEY thay SUPABASE_SECRET_KEY.

# Xác thực (JWT + refresh token)
JWT_ACCESS_SECRET=đổi-khóa-bí-mật-tối-thiểu-16-ký-tự
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
REFRESH_COOKIE_NAME=aura_rt
BCRYPT_ROUNDS=12

# Phân phối media (Task 9)
# Origin công khai của API — dựng URL media tuyệt đối cho FE chạy khác origin.
MEDIA_PUBLIC_BASE_URL=http://localhost:3001
# Khóa HMAC ký URL xem trước media chưa công khai (>= 32 ký tự). BẮT BUỘC đổi ở môi trường thật.
MEDIA_URL_SIGNING_SECRET=đổi-khóa-ký-url-media-tối-thiểu-32-ký-tự
MEDIA_SIGNED_URL_TTL_SECONDS=900

# Nơi lưu file media: local (đĩa, dev) | supabase (Supabase Storage)
# Khi = supabase: dùng SUPABASE_URL / SUPABASE_SECRET_KEY / SUPABASE_STORAGE_BUCKET ở đầu file
# (cùng bucket PRIVATE với GLB của tour). File chỉ ra ngoài qua API, không public bucket.
MEDIA_STORAGE_DRIVER=local

# Seed admin đầu tiên (chỉ dùng khi chạy `npm run seed`)
SEED_ADMIN_EMAIL=admin@aura.local
SEED_ADMIN_PASSWORD=

# Chạy local
NODE_ENV=development
