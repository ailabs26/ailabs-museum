@echo off
REM install.cmd -- install the chrome-profile CLI shim onto PATH on Windows.
REM
REM Creates a small shim at %PREFIX%\bin\chrome-profile.cmd that invokes the
REM bundled Python CLI. Idempotent. Default prefix is %USERPROFILE%\.local.
REM
REM Usage:
REM   install.cmd                              install to %USERPROFILE%\.local\bin
REM   set PREFIX=C:\tools && install.cmd       custom prefix

setlocal

set "SCRIPT_DIR=%~dp0"
if "%SCRIPT_DIR:~-1%"=="\" set "SCRIPT_DIR=%SCRIPT_DIR:~0,-1%"
set "CLI=%SCRIPT_DIR%\chrome_profile_cli.py"

if not exist "%CLI%" (
  echo install.cmd: cannot find %CLI%
  exit /b 1
)

where python >nul 2>&1
if errorlevel 1 (
  where py >nul 2>&1
  if errorlevel 1 (
    echo install.cmd: neither 'python' nor 'py' on PATH. Install Python 3.9+ first.
    exit /b 1
  )
  set "PY=py -3"
) else (
  set "PY=python"
)

if "%PREFIX%"=="" set "PREFIX=%USERPROFILE%\.local"
set "BIN_DIR=%PREFIX%\bin"
if not exist "%BIN_DIR%" (
  mkdir "%BIN_DIR%" >nul 2>&1
  if errorlevel 1 (
    echo install.cmd: cannot create %BIN_DIR%
    exit /b 1
  )
)
if not exist "%BIN_DIR%\" (
  echo install.cmd: destination is not a directory: %BIN_DIR%
  exit /b 1
)

set "SHIM=%BIN_DIR%\chrome-profile.cmd"
if exist "%SHIM%\" (
  echo install.cmd: shim path is a directory: %SHIM%
  exit /b 1
)
set "TEMP_SHIM=%SHIM%.tmp-%RANDOM%-%RANDOM%"
> "%TEMP_SHIM%" echo @echo off
if errorlevel 1 goto :write_failed
>> "%TEMP_SHIM%" echo REM auto-generated by chrome-profile install.cmd
if errorlevel 1 goto :write_failed
>> "%TEMP_SHIM%" echo %PY% "%CLI%" %%*
if errorlevel 1 goto :write_failed

move /Y "%TEMP_SHIM%" "%SHIM%" >nul 2>&1
if errorlevel 1 goto :replace_failed
if not exist "%SHIM%" goto :verify_failed
for %%I in ("%SHIM%") do if %%~zI LEQ 0 goto :verify_failed

echo [+] installed: %SHIM% -^> %CLI%

echo %PATH% | findstr /I /C:"%BIN_DIR%" >nul
if errorlevel 1 (
  echo [!] %BIN_DIR% is not on PATH. Add it once, then reopen your terminal:
  echo     setx PATH "%%PATH%%;%BIN_DIR%"
)

echo [*] next: chrome-profile setup
endlocal & exit /b 0

:write_failed
del /F /Q "%TEMP_SHIM%" >nul 2>&1
echo install.cmd: cannot write shim in %BIN_DIR%
endlocal & exit /b 1

:replace_failed
del /F /Q "%TEMP_SHIM%" >nul 2>&1
echo install.cmd: cannot replace %SHIM%; close processes using it and retry.
endlocal & exit /b 1

:verify_failed
echo install.cmd: shim verification failed: %SHIM%
endlocal & exit /b 1
