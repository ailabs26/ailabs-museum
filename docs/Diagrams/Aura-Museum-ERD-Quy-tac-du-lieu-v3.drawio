        <mxCell id="ext_ref" value="FK về MVP: exhibit_translations.revision_id → exhibit_revisions.id  •  api_keys.created_by → users.id  •  analytics_events.exhibit_id → exhibits.id" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=18;fontColor=#23313D;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;" parent="1" vertex="1">
