        </mxCell>
        <mxCell id="analytics_rule_body" value="expires_at = received_at + 41 ngày. Job xóa idempotent; không thu email, IP thô hoặc vị trí chính xác." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;fontColor=#23313D;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;" parent="1" vertex="1">
