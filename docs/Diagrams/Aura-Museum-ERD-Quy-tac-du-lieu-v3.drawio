        <mxCell id="translation_rule_body" value="UNIQUE(revision_id, locale). Chỉ trả bản dịch đã duyệt; thiếu locale dùng tiếng Việt và ghi resolvedLocale." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;fontColor=#23313D;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;" parent="1" vertex="1">
