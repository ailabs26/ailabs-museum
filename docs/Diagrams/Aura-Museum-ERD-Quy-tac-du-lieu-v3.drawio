  <diagram id="rules" name="02 - Quy tắc dữ liệu">
    <mxGraphModel dx="1860" dy="980" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1610" pageHeight="1640" math="0" shadow="0" background="#F6F8FA">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="rules_title" value="AURA MUSEUM  /  QUY TẮC DỮ LIỆU" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=29;fontColor=#23313D;fontStyle=1;strokeColor=none;fillColor=none;spacing=0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="45" y="30" width="1500" height="55" />
        </mxCell>
        <mxCell id="rules_subtitle" value="Áp dụng cho 13 bảng MVP; các trạng thái và độ dài là đề xuất để duyệt trước migration." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#5D7280;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="45" y="92" width="1500" height="35" />
        </mxCell>
        <mxCell id="rule_0" value="" style="rounded=1;arcSize=9;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#D8E0E7;strokeWidth=1.3;shadow=0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="45" y="160" width="735" height="255" />
        </mxCell>
        <mxCell id="rule_0_strip" value="" style="rounded=0;fillColor=#24715E;strokeColor=#24715E;" parent="rule_0" vertex="1">
          <mxGeometry as="geometry" x="0" y="0" width="6" height="255" />
        </mxCell>
        <mxCell id="rule_0_title" value="01  Khóa và quan hệ" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=18;fontColor=#24715E;fontStyle=1;strokeColor=none;fillColor=none;spacing=0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="67" y="172" width="693" height="32" />
        </mxCell>
        <mxCell id="rule_0_body" value="UUID cho bảng chính; user_roles và role_permissions dùng PK ghép.&#xa;FK bắt buộc: exhibit → room, revision → exhibit, hotspot → revision.&#xa;Không xóa cứng room, exhibit, media hoặc revision đang được tham chiếu." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;fontColor=#23313D;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="67" y="210" width="691" height="195" />
        </mxCell>
        <mxCell id="rule_1" value="" style="rounded=1;arcSize=9;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#D8E0E7;strokeWidth=1.3;shadow=0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="815" y="160" width="735" height="255" />
        </mxCell>
        <mxCell id="rule_1_strip" value="" style="rounded=0;fillColor=#28628F;strokeColor=#28628F;" parent="rule_1" vertex="1">
          <mxGeometry as="geometry" x="0" y="0" width="6" height="255" />
        </mxCell>
        <mxCell id="rule_1_title" value="02  Revision và nội dung public" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=18;fontColor=#28628F;fontStyle=1;strokeColor=none;fillColor=none;spacing=0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="837" y="172" width="693" height="32" />
        </mxCell>
        <mxCell id="rule_1_body" value="UNIQUE(exhibit_id, revision_no); revision_no tăng trong từng exhibit.&#xa;Một lần lưu tạo revision mới; nội dung và hotspot đã submit/duyệt là bất biến.&#xa;Public chỉ đọc published_revision_id khi visibility = visible và room active." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;fontColor=#23313D;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="837" y="210" width="691" height="195" />
        </mxCell>
        <mxCell id="rule_2" value="" style="rounded=1;arcSize=9;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#D8E0E7;strokeWidth=1.3;shadow=0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="45" y="443" width="735" height="255" />
        </mxCell>
        <mxCell id="rule_2_strip" value="" style="rounded=0;fillColor=#28628F;strokeColor=#28628F;" parent="rule_2" vertex="1">
          <mxGeometry as="geometry" x="0" y="0" width="6" height="255" />
        </mxCell>
        <mxCell id="rule_2_title" value="03  Xuất bản an toàn" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=18;fontColor=#28628F;fontStyle=1;strokeColor=none;fillColor=none;spacing=0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="67" y="455" width="693" height="32" />
        </mxCell>
        <mxCell id="rule_2_body" value="published_revision_id phải thuộc cùng exhibit; revision phải được duyệt.&#xa;Làm migration vòng FK bằng bước ADD CONSTRAINT sau khi tạo hai bảng.&#xa;Publish/hide cùng audit trong một transaction; lỗi thì rollback toàn bộ." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;fontColor=#23313D;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="67" y="493" width="691" height="195" />
        </mxCell>
        <mxCell id="rule_3" value="" style="rounded=1;arcSize=9;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#D8E0E7;strokeWidth=1.3;shadow=0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="815" y="443" width="735" height="255" />
        </mxCell>
        <mxCell id="rule_3_strip" value="" style="rounded=0;fillColor=#24715E;strokeColor=#24715E;" parent="rule_3" vertex="1">
          <mxGeometry as="geometry" x="0" y="0" width="6" height="255" />
        </mxCell>
        <mxCell id="rule_3_title" value="04  Khóa lạc quan" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=18;fontColor=#24715E;fontStyle=1;strokeColor=none;fillColor=none;spacing=0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="837" y="455" width="693" height="32" />
        </mxCell>
        <mxCell id="rule_3_body" value="PATCH/submit/publish/hide gửi expectedVersion.&#xa;UPDATE exhibits ... WHERE id = ? AND version = expectedVersion; tăng version 1.&#xa;Không cập nhật được dòng nào → HTTP 409; client tải lại và hợp nhất." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;fontColor=#23313D;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="837" y="493" width="691" height="195" />
        </mxCell>
        <mxCell id="rule_4" value="" style="rounded=1;arcSize=9;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#D8E0E7;strokeWidth=1.3;shadow=0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="45" y="726" width="735" height="255" />
        </mxCell>
        <mxCell id="rule_4_strip" value="" style="rounded=0;fillColor=#A66A28;strokeColor=#A66A28;" parent="rule_4" vertex="1">
          <mxGeometry as="geometry" x="0" y="0" width="6" height="255" />
        </mxCell>
        <mxCell id="rule_4_title" value="05  Media và hotspot" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=18;fontColor=#A66A28;fontStyle=1;strokeColor=none;fillColor=none;spacing=0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="67" y="738" width="693" height="32" />
        </mxCell>
        <mxCell id="rule_4_body" value="Revision có tối đa 1 model, 1 image, 1 audio theo ba FK riêng.&#xa;Chỉ publish asset ready, đúng kind; ảnh cần alt text, audio cần transcript.&#xa;Hotspot gắn revision, tọa độ hữu hạn, display_order ≥ 0; sanitize text." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;fontColor=#23313D;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="67" y="776" width="691" height="195" />
        </mxCell>
        <mxCell id="rule_5" value="" style="rounded=1;arcSize=9;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#D8E0E7;strokeWidth=1.3;shadow=0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="815" y="726" width="735" height="255" />
        </mxCell>
        <mxCell id="rule_5_strip" value="" style="rounded=0;fillColor=#7659A5;strokeColor=#7659A5;" parent="rule_5" vertex="1">
          <mxGeometry as="geometry" x="0" y="0" width="6" height="255" />
        </mxCell>
        <mxCell id="rule_5_title" value="06  Auth và RBAC" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=18;fontColor=#7659A5;fontStyle=1;strokeColor=none;fillColor=none;spacing=0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="837" y="738" width="693" height="32" />
        </mxCell>
        <mxCell id="rule_5_body" value="Email không phân biệt hoa thường, UNIQUE. Permission theo action/resource.&#xa;Refresh token chỉ lưu hash; rotate tạo session mới trong cùng family.&#xa;Token cũ bị dùng lại → thu hồi cả family; disabled user bị từ chối." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;fontColor=#23313D;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="837" y="776" width="691" height="195" />
        </mxCell>
        <mxCell id="rule_6" value="" style="rounded=1;arcSize=9;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#D8E0E7;strokeWidth=1.3;shadow=0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="45" y="1009" width="735" height="255" />
        </mxCell>
        <mxCell id="rule_6_strip" value="" style="rounded=0;fillColor=#A94F57;strokeColor=#A94F57;" parent="rule_6" vertex="1">
          <mxGeometry as="geometry" x="0" y="0" width="6" height="255" />
        </mxCell>
        <mxCell id="rule_6_title" value="07  Report và audit" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=18;fontColor=#A94F57;fontStyle=1;strokeColor=none;fillColor=none;spacing=0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="67" y="1021" width="693" height="32" />
        </mxCell>
        <mxCell id="rule_6_body" value="Report: open → in_progress → resolved/dismissed, lý do xử lý bắt buộc.&#xa;Report không bắt buộc định danh khách; kiểm tra độ dài và rate limit.&#xa;Audit append-only, ghi actor/action/resource/request_id; không ghi token." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;fontColor=#23313D;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="67" y="1059" width="691" height="195" />
        </mxCell>
        <mxCell id="rule_7" value="" style="rounded=1;arcSize=9;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#D8E0E7;strokeWidth=1.3;shadow=0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="815" y="1009" width="735" height="255" />
        </mxCell>
        <mxCell id="rule_7_strip" value="" style="rounded=0;fillColor=#24715E;strokeColor=#24715E;" parent="rule_7" vertex="1">
          <mxGeometry as="geometry" x="0" y="0" width="6" height="255" />
        </mxCell>
        <mxCell id="rule_7_title" value="08  Chỉ mục và sắp xếp" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=18;fontColor=#24715E;fontStyle=1;strokeColor=none;fillColor=none;spacing=0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="837" y="1021" width="693" height="32" />
        </mxCell>
        <mxCell id="rule_7_body" value="INDEX exhibits(room_id, display_order, id).&#xa;UNIQUE revisions(exhibit_id, revision_no); INDEX reports(status, created_at).&#xa;INDEX audit_logs(resource_type, resource_id, occurred_at); order phụ theo id." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;fontColor=#23313D;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="837" y="1059" width="691" height="195" />
        </mxCell>
        <mxCell id="rule_8" value="" style="rounded=1;arcSize=9;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#D8E0E7;strokeWidth=1.3;shadow=0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="45" y="1292" width="735" height="255" />
        </mxCell>
        <mxCell id="rule_8_strip" value="" style="rounded=0;fillColor=#A94F57;strokeColor=#A94F57;" parent="rule_8" vertex="1">
          <mxGeometry as="geometry" x="0" y="0" width="6" height="255" />
        </mxCell>
        <mxCell id="rule_8_title" value="09  Xóa mềm và vòng đời" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=18;fontColor=#A94F57;fontStyle=1;strokeColor=none;fillColor=none;spacing=0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="67" y="1304" width="693" height="32" />
        </mxCell>
        <mxCell id="rule_8_body" value="rooms, exhibits, media, users: is_deleted mặc định false; deleted_at mặc định NULL.&#xa;CHECK (is_deleted = (deleted_at IS NOT NULL)); truy vấn thường lọc is_deleted = false.&#xa;Không xóa media đang dùng cho bản public; giữ revision, report và audit để truy vết." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;fontColor=#23313D;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="67" y="1342" width="691" height="195" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
