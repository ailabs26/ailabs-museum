        <mxCell id="keys_rule_body" value="Chỉ lưu hash, scope đọc, hạn dùng, hạn mức và thu hồi. Không dùng làm phiên CMS hay nhúng vào trình duyệt." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;fontColor=#23313D;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;" parent="1" vertex="1">
